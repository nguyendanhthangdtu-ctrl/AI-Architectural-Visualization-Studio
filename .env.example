# Copy to .env and fill in real values. Never commit .env — see docs/16_SECURITY_SPEC.md.
# Provider credentials (validate current provider docs before use — docs/10_MODEL_ADAPTER_SPEC.md)

# Nano Banana adapter (BUILD 12) — Google Gemini's native image generation
# (same Gemini API family as GEMINI_API_KEY below, kept as its own key per
# docs/10's per-feature separation). Get a key at
# https://ai.google.dev/gemini-api/docs/api-key . Without it, generation
# requests fail with PROVIDER_NOT_CONFIGURED.
NANO_BANANA_API_KEY=

# Google Flow adapter — BUILD 12 found no official public REST API for
# Google Flow itself (see packages/model-adapters/src/provider-adapters.ts);
# this key is reserved for if/when Google publishes one, but the adapter
# stays NOT_IMPLEMENTED regardless of whether it's set.
GOOGLE_FLOW_API_KEY=

# ChatGPT Image adapter (BUILD 12) — OpenAI gpt-image-1 via the Images API.
# Get a key at https://platform.openai.com/api-keys . Without it, generation
# requests fail with PROVIDER_NOT_CONFIGURED.
CHATGPT_IMAGE_API_KEY=

# Veo adapter (BUILD 16) — Image → Video via Google's Veo API (same Gemini
# API family as GEMINI_API_KEY, kept as its own key per docs/10's per-feature
# separation). Get a key at https://ai.google.dev/gemini-api/docs/api-key .
# Without it, video submit()/pollStatus() fail with PROVIDER_NOT_CONFIGURED.
VEO_API_KEY=

# Sora adapter — reserved for completeness, but BUILD 16 found OpenAI's
# Sora 2 Videos API is deprecated and shutting down 2026-09-24; the adapter
# stays NOT_IMPLEMENTED regardless of whether this is set (see
# packages/model-adapters/src/sora-adapter.ts).
SORA_API_KEY=

# Vision Analysis Engine (BUILD 07) — Google Gemini. Get a key at
# https://ai.google.dev/gemini-api/docs/api-key . Without it, analysis
# requests fail with PROVIDER_NOT_CONFIGURED rather than the server refusing
# to start.
GEMINI_API_KEY=

# Database (BUILD 18 — real, node:sqlite-backed; docs/03 §13). A filesystem
# path node:sqlite's DatabaseSync opens directly (created if missing), or
# ':memory:' for an ephemeral instance. Unset/empty defaults to ':memory:' —
# real persistence across restarts needs this set to a real file path, e.g.
# ./data/avs.sqlite3.
DATABASE_URL=

# Blob/asset storage (BUILD 18 — real, local-disk backed; docs/03 §13). The
# directory asset bytes are written under (created if missing). Unset/empty
# defaults to a fresh OS temp directory per process (ephemeral) — real
# persistence across restarts needs this set to a real directory, e.g.
# ./data/assets. ASSET_STORE_ACCESS_KEY/ASSET_STORE_SECRET_KEY stay unused
# until a real cloud object-store vendor swap (S3/GCS/etc.).
ASSET_STORE_URL=
ASSET_STORE_ACCESS_KEY=
ASSET_STORE_SECRET_KEY=

# CORS allowlist (BUILD 18, docs/16) — comma-separated origins allowed to
# call this API from a browser. Unset defaults to the Vite dev server's own
# origin (http://localhost:5173).
ALLOWED_ORIGINS=

# Signs the time-limited asset URLs GET /assets/:id can require (BUILD 18,
# docs/03 §9). Unset: asset URLs stay plain/unauthenticated (today's
# behavior). Set to a real random secret to enable signed, expiring asset
# URLs for real — required for a production deployment.
ASSET_URL_SIGNING_SECRET=

# --- RELEASE 02 (Security & Production Access Hardening) — REQUIRED for any
# real deployment beyond your own local machine ---

# Gates POST /auth/register (docs/16 "private deployment," never open public
# self-registration). Unset: registration is entirely disabled. Set to a
# real random secret and share it privately with intended users — it is not
# a per-user password, just an invite gate.
REGISTRATION_SECRET=

# Set to "true" only once a real HTTPS reverse proxy sits in front of this
# server (docs/03 §11: CLIENT -> HTTPS/TLS REVERSE PROXY -> API) — this app
# never terminates TLS itself and never fakes one. Controls the session
# cookie's Secure attribute and whether Strict-Transport-Security is sent.
# Defaults to "false" so local dev over plain HTTP keeps working with zero
# configuration. Accepted values: "true" or "false" (anything else is
# rejected, not silently coerced). BUILD 19: setting this to "true" without
# ASSET_URL_SIGNING_SECRET set will now refuse to start the server.
TRUST_HTTPS=false

# API service
API_PORT=8080
